APP_URL=https://localhost/@Atalaya
AUTH_SESSION_NAME=atalaya_auth

# Railway Postgres (preferred)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Or discrete vars
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=atalaya
# PGUSER=postgres
# PGPASSWORD=

# Cloudflare Email Service
# https://developers.cloudflare.com/email-service/get-started/send-emails/
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_FROM_EMAIL=auth@yourdomain.com
